+            LoadConfig();
+            _loaded = true;
+            RenderCards();
+            LoggerHelper.UserAction($"打开 {Title}", $"任务职业={_taskProfession}, 显示职业={_profession}, 配置文件={_configPath}", operation: "HifPriorityEditor");
+        }
