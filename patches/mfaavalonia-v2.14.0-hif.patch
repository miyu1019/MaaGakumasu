+            UpdateHeading();
+            RenderCards();
+        };
+        navigationRow.Children.Add(_swapOutModeButton);
+        _swapOutImport.Click += (_, _) => ShowCardImportDialog(false, true);
+        navigationRow.Children.Add(_swapOutImport);
+        toolbar.Children.Add(navigationRow);
