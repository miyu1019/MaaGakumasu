+    private async Task<MaaJobStatus> RunIndependentHifTaskAsync(string entry, string? param, CancellationToken token)
+    {
+        // Separate OCR/detection models and node caches; upstream updates cannot alter HIF resources.
+        var paths = HifLayout.ResourcePaths(ViewModel?.CurrentResource);
+        using var resource = new MaaResource(paths);
+        Instances.PerformanceUserControlModel.ChangeGpuOption(resource, Instances.PerformanceUserControlModel.GpuOption);
+        // Keep the existing device connection and its screenshot/input settings.
+        // Only resources and Tasker are isolated; do not open a second MuMu SDK session.
+        var controller = MaaTasker?.Controller ?? throw new InvalidOperationException("HIF 执行前尚未连接控制器");
+        using var tasker = new MaaTasker
+        {
+            Controller = controller, Resource = resource,
+            Toolkit = Toolkit, Global = Global, DisposeOptions = (DisposeOptions)0
+        };
+        tasker.Callback += HandleCallBack;
+        var agents = new List<AgentContext>();
+        using var cancellation = token.Register(() => tasker.Stop());
+        Interlocked.Exchange(ref _hifLastScreenshotTicks, Stopwatch.GetTimestamp());
+        Interlocked.Exchange(ref _hifScreenshotRecoveryFailed, 0);
+        Interlocked.Exchange(ref _hifScreenshotFailureTicks, 0);
+        Volatile.Write(ref _activeHifTasker, tasker);
+        controller.Callback += HandleHifControllerCallback;
+        // This also bounds recovery when the live view is collapsed or disabled.
+        using var screenshotWatchdog = new System.Threading.Timer(_ =>
+        {
+            if (IsHifScreenshotRecoveryExpired)
+                StopHifForScreenshotTimeout();
+        }, null, Timeout.Infinite, Timeout.Infinite);
+        try
+        {
+            if (AgentHelper.HasAgentConfigs(Interface?.Agent))
+            {
+                var configs = Interface!.Agent!.Select(c => new MaaInterface.MaaInterfaceAgent
+                {
+                    ChildExec = c.ChildExec, ChildArgs = [.. c.ChildArgs ?? [], "--hif-only"],
+                    Identifier = c.Identifier, Timeout = c.Timeout
+                }).ToList();
+                agents = await AgentHelper.StartAgentsAsync(tasker, configs, InstanceConfiguration, this, token);
+            }
+            var job = tasker.AppendTask(entry, param ?? "{}");
+            Interlocked.Exchange(ref _hifLastScreenshotTicks, Stopwatch.GetTimestamp());
+            screenshotWatchdog.Change(1000, 1000);
+            TelemetryService.SetActiveTaskId(InstanceId, job.Id);
+            var result = await TaskManager.RunTaskAsync(() => job.Wait(), token, ex => throw ex,
+                name: "HIF独立任务", catchException: true, shouldLog: false);
+            return Volatile.Read(ref _hifScreenshotRecoveryFailed) != 0 ? MaaJobStatus.Failed : result;
+        }
+        finally
+        {
+            cancellation.Dispose();
+            using var watchdogDrained = new ManualResetEvent(false);
+            if (screenshotWatchdog.Dispose(watchdogDrained)) watchdogDrained.WaitOne();
+            // Waiting for the original job is insufficient after PostStop clears its status.
+            // The stop marker runs after the worker's current recognition/action has returned.
+            await TaskManager.RunTaskAsync(() => tasker.Stop().Wait(), CancellationToken.None,
+                name: "等待HIF原生任务停止", catchException: false, shouldLog: false, noMessage: true);
+            controller.Callback -= HandleHifControllerCallback;
+            Volatile.Write(ref _activeHifTasker, null);
+            tasker.Callback -= HandleCallBack;
+            AgentHelper.KillAllAgents(agents);
+        }
