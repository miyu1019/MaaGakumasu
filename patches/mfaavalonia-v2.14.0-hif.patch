+        {
+            RenderSwapOutCards();
+            return;
+        }
+        if (_targetMode)
+        {
+            RenderTargetCards();
+            return;
+        }
+        RenderUnknownPriority();
+        _import.IsEnabled = _loaded && _catalog.Properties().Any(entry => cards.All(card => (string?)card["key"] != entry.Name));
+        if (cards.Count == 0)
