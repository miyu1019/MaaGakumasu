  "option": {
    "HIF.HIF Debug": {
      "type": "switch",
      "default_case": "No",
      "label": "Debug（HIF诊断截图）",
      "description": "开启后保存手牌识别异常截图，以及未选中时的点击前后对照截图；默认关闭，关闭时仍保留文字日志。仅作用于 HIF。",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "ProduceHIF__ProduceHIFDebug": {
              "enabled": true
            }
          }
        },
        {
          "name": "No",
          "pipeline_override": {
            "ProduceHIF__ProduceHIFDebug": {
              "enabled": false
            }
          }
        }
      ]
    },
    "HIF.重开分数线": {
      "type": "input",
      "label": "​",
      "inputs": [
        {
          "name": "rechallenge_threshold",
          "label": "本战1再挑战分数线",
          "description": "分数低于此则重开本战1",
          "default": "700000",
          "pipeline_type": "int",
          "verify": "^\\d{6,}$",
          "pattern_msg": "请输入6位以上数字(如700000)"
        }
      ],
      "pipeline_override": {
        "ProduceHIF__ProduceHIFReChallengeFlag": {
          "max_hit": "{rechallenge_threshold}"
        }
      }
    },
    "HIF.本战1再挑战": {
      "type": "switch",
      "default_case": "No",
      "description": "开启后本战1顺位非第一时点「再挑戦」",
      "label": "本战1再挑战",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "ProduceHIF__ProduceHIFReChallengeFlag": {
              "enabled": true
            }
          }
        },
        {
          "name": "No"
        }
      ]
    },
    "HIF.SKIP本战2": {
      "type": "switch",
      "default_case": "No",
      "label": "SKIP本战2",
      "description": "仅 HIF 路线。以战斗开始时左上角的 12 回合判定为本战2；开启后该场每回合点击 SKIP，不出牌。",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "ProduceHIF__ProduceHIFBattle2Skip": {
              "enabled": true
            }
          }
        },
        {
          "name": "No"
        }
      ]
    },
    "HIF.SKIP本战1": {
      "type": "switch",
      "default_case": "No",
      "label": "SKIP本战1",
      "description": "仅 HIF 路线。以战斗开始时左上角的 9 回合判定为本战1；开启后该场每回合点击 SKIP，不出牌。",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "ProduceHIF__ProduceHIFBattle1Skip": {
              "enabled": true
            }
          }
        },
        {
          "name": "No"
        }
      ]
    },
    "HIF.HIF技能卡定制": {
      "type": "switch",
      "default_case": "Yes",
      "label": "HIF技能卡定制",
      "description": "开启时按「HIF技能卡定制配置」面板已选项目定制卡牌；关闭时保留面板选择，只跳过本次定制。中场回血和定制后购饮仍由各自开关控制。",
      "cases": [
        {
          "name": "Yes"
        },
        {
          "name": "No",
          "pipeline_override": {
            "ProduceHIF__ProduceHIFCardCustomEnabled": {
              "enabled": false
            }
          }
        }
      ]
    },
    "HIF.HIF中场休息回血": {
      "type": "switch",
      "default_case": "No",
      "label": "HIF中场休息回血",
      "description": "开启后，在中场休息商店点回復、固定点10次＋并确认；等待商店页恢复后继续技能卡定制及已开启的购饮流程。",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "ProduceHIF__ProduceHIFIntervalHeal": {
              "enabled": true
            }
          }
        },
        {
          "name": "No"
        }
      ]
    },
    "HIF.自定义卡后购买饮料": {
      "type": "switch",
      "default_case": "No",
      "label": "技能卡定制后购买饮料",
      "description": "开启后，技能卡定制结束时按当前职业饮料面板中勾选「购买」的顺序比较右下两格；无合适饮料时限次刷新，饮料栏满时停止",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "ProduceHIF__ProduceHIFCustomEndBuyDrink": {
              "enabled": true
            }
          }
        },
        {
          "name": "No"
        }
      ]
    },
    "HIF.相谈购买饮料": {
      "type": "switch",
      "default_case": "No",
      "label": "相谈购买饮料",
      "description": "开启后按当前职业饮料面板中勾选「购买」的顺序，在相谈商店选择可负担的饮料；名单为空则不购买",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "ProduceHIF__ProduceHIFConsultBuyDrink": {
              "enabled": true
            },
            "ProduceHIF__ProduceHIFConsultShopFlag": {
              "enabled": true
            }
          }
        },
        {
          "name": "No"
        }
      ]
    },
    "HIF.第二次授业：相谈删除本次换入卡": {
      "type": "switch",
      "default_case": "No",
      "label": "第二次授业：相谈删除本次换入卡",
      "description": "仅 HIF 路线。记录前两次授业换入的卡；第二次优先换出第一次换入的卡，并在之后的相谈商店删除第二次换入的卡。本模式优先于「第二次授业：优先换出首次换入卡」。",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "ProduceHIF__ProduceHIFSecondSwapConsultDeleteAcquiredCard": {
              "enabled": true
            },
            "ProduceHIF__ProduceHIFConsultShopFlag": {
              "enabled": true
            }
          }
        },
        {
          "name": "No"
        }
      ]
    },
    "HIF.第二次授业：优先换出首次换入卡": {
      "type": "switch",
      "default_case": "No",
      "label": "第二次授业：优先换出首次换入卡",
      "description": "仅 HIF 路线。第一次授业换卡记录换入卡；第二次优先换出该卡，找不到时依次查优先换出名单和基本卡。换入时优先从「HIF优先获取卡配置」的当前职业名单中选择。本开关不在相谈商店删卡；同时开启「第二次授业：相谈删除本次换入卡」时，按后者流程。",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "ProduceHIF__ProduceHIFSecondSwapPreferFirstAcquiredCardOut": {
              "enabled": true
            }
          }
        },
        {
          "name": "No"
        }
      ]
    },
