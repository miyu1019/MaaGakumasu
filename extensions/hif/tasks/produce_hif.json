        {
          "name": "3",
          "pipeline_override": {
            "ProduceHIF__ProduceLoop": {
              "max_hit": 3
            }
          },
          "label": "3"
        },
        {
          "name": "4",
          "pipeline_override": {
            "ProduceHIF__ProduceLoop": {
              "max_hit": 4
            }
          },
          "label": "4"
