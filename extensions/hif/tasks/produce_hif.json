        {
          "name": "好印象",
          "pipeline_override": {
            "ProduceHIF__ProduceHIFProfessionFlag": {
              "max_hit": 3
            }
          }
        },
        {
          "name": "元気",
          "pipeline_override": {
            "ProduceHIF__ProduceHIFProfessionFlag": {
              "max_hit": 4
            }
          }
        },
        {
          "name": "全力",
          "pipeline_override": {
            "ProduceHIF__ProduceHIFProfessionFlag": {
              "max_hit": 5
            }
          }
        },
        {
          "name": "強気",
          "pipeline_override": {
            "ProduceHIF__ProduceHIFProfessionFlag": {
              "max_hit": 6
            }
          }
        }
      ]
    },
    "HIF.跳过准备阶段": {
      "type": "switch",
      "default_case": "No",
      "description": "$跳过准备阶段说明",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "ProduceHIF__ProduceSkipPreparation": {
              "enabled": true
            }
          }
        },
        {
          "name": "No"
        }
      ],
      "label": "$跳过准备阶段"
