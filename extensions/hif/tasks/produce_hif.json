              "enabled": true
            }
          },
          "label": "$支援强化Pt提升"
        },
        {
          "name": "笔记数量提升",
          "description": "![](extensions/hif/resource/base/image/hif/items/note_increased.png)",
          "pipeline_override": {
            "ProduceHIF__ProduceUsePt": {
              "enabled": true
            }
          },
          "label": "$笔记数量提升"
        }
      ],
      "label": "$使用道具"
    },
