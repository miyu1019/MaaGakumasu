        {
          "name": "∞",
          "label": "∞"
        },
        {
          "name": "手动输入次数",
          "label": "$手动输入次数",
          "option": [
            "HIF.手动输入培育次数"
          ]
        }
      ]
    },
    "HIF.手动输入培育次数": {
      "type": "input",
      "inputs": [
        {
          "name": "produce_times",
          "label": "$手动输入培育次数",
          "default": "1",
          "pipeline_type": "int",
          "verify": "^[1-9]\\d*$",
          "pattern_msg": "$手动输入培育次数输入框说明"
        }
      ],
      "pipeline_override": {
        "ProduceHIF__ProduceLoop": {
          "max_hit": "{produce_times}"
        }
      },
      "label": "手动输入培育次数"
    },
